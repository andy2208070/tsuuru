{
  "name": "tsuuru",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @tsuuru/portal dev",
    "dev:all": "pnpm --parallel --filter @tsuuru/portal --filter @tsuuru/tts-web --filter @tsuuru/web-b dev",
    "dev:portal": "pnpm --filter @tsuuru/portal dev",
    "dev:tts-web": "pnpm --filter @tsuuru/tts-web dev",
    "dev:web-b": "pnpm --filter @tsuuru/web-b dev",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "tts:dev": "uv run --directory services/tts-api uvicorn app.main:app --reload",
    "tts:test": "uv run --directory services/tts-api pytest"
  }
}